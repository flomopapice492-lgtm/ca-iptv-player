# Backend Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# EPG Configuration
EPG_CACHE_DIR=./epg-data/cache
EPG_UPDATE_INTERVAL=3600000
EPG_TIMEOUT=30000

# Channel Configuration
CHANNEL_LIST_PATH=./public-channels/canada.m3u
CHANNEL_LOGO_PATH=./public-channels/logos

# API Configuration
API_CORS_ORIGIN=http://localhost:3000
API_RATE_LIMIT=100

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Security
ALLOW_EXTERNAL_URLS=false
HTTPS_ONLY=false

# Advanced
DEBUG=false
CACHE_SIZE_MB=500
